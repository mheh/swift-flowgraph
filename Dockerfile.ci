# The image that CI publishes. Nothing compiles here: the context is the folder that Scripts/build.sh filled.
# Keep it the same as the last stage of Dockerfile, apart from where the files come from.
ARG SWIFT_IMAGE=swift:6.4-noble
FROM ${SWIFT_IMAGE}
# The page and its scripts are in the resources folder, which the tool finds beside its binary.
COPY . /usr/local/bin/
# A project that CI checked out belongs to another user than the one of the container.
RUN git config --system --add safe.directory '*'
WORKDIR /work
ENTRYPOINT ["flowgraph"]
CMD ["--help"]
